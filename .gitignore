# SwiftPM / Xcode / macOS
.build/
DerivedData/
# 仅忽略 Xcode 用户私有数据，工程文件本身纳入版本控制
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
xcuserdata/
.swiftpm/xcode/
Package.resolved

# Xcode
.DS_Store

# 事件持久化数据文件 (本地沙箱)
calendar_events.json
*.json
# 资源 JSON 文件（农历数据表 / 黄历离散库）必须纳入版本控制
!Sources/LunisolarCalendarApp/Resources/*.json
# ⚠️ asset catalog 的 Contents.json 也必须纳入版本控制。
#   上面那条全局 `*.json` 曾把它一起忽略，导致远端 AppIcon.appiconset 里
#   只有 Icon-1024.png、没有 Contents.json —— 干净克隆后 Xcode 没有可用的
#   AppIcon 资产目录，归档/上架受影响。新增 asset catalog 时不要删这两条反选。
!**/*.xcassets/**/Contents.json
# Xcode 工程自身的 json（如 scheme 元数据）同理
!**/*.xcodeproj/**/*.json

# 编辑器
.idea/
.vscode/
*.swp
*~

# 开发期 AI 工具目录（不应进入产品仓库；如需保留请放到仓库外）
.trae/
# iOS 开发插件（同样属于 Agent 工具，不是产品代码）
# 2026-10-03：插件已独立成 git 仓库（Tools/ios-dev-helper/.git，随其自身
# .github/workflows/ci.yml 单独 CI）。这里恢复整目录忽略，避免产品仓库把它
# 当作 embedded repo 收进来。
Tools/ios-dev-helper/
# 会话级临时目录（截图、隔离构建沙箱等）；2026-10-03 曾误提交进仓库一次
.dsh-*/
# ios-dev-helper 的工作区临时目录（simulator_screenshot 的截图、derivedDataPath 等）
.dsh/

# 日志
*.log

# 临时上传目录（截屏等）
.uploads/
.i18n_work/
